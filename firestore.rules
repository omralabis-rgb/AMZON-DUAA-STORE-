rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common security helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Strict primary admin verification:
    // Requires verified Google authentication specifically for alabsiamal14@gmail.com
    function isPrimaryAdmin() {
      return isSignedIn() &&
        request.auth.token.email == "alabsiamal14@gmail.com" &&
        request.auth.token.email_verified == true &&
        request.auth.token.firebase.sign_in_provider == "google.com";
    }

    function isAdmin() {
      return isPrimaryAdmin() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        isPrimaryAdmin()
      );
    }

    // Users collection and subcollections
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().uid == userId &&
        (incoming().role == 'user' || (isAdmin() && incoming().role == 'admin'));
      allow update: if (isOwner(userId) || isAdmin()) && (
        isAdmin() ||
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photoURL', 'updatedAt']) &&
          incoming().role == existing().role &&
          incoming().uid == existing().uid
        )
      );
      allow delete: if isAdmin();

      // Subcollections: Favorites
      match /favorites/{productId} {
        allow read, write: if isOwner(userId) && isValidId(productId);
      }

      // Subcollections: Cart
      match /cart/{productId} {
        allow read, write: if isOwner(userId) && isValidId(productId);
      }
    }

    // Admins authorization collection
    match /admins/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin() &&
        isOwner(userId) &&
        isValidId(userId) &&
        incoming().keys().hasAll(['email', 'role']) &&
        incoming().keys().hasOnly(['uid', 'email', 'role', 'provider', 'createdAt', 'updatedAt']) &&
        incoming().email == "alabsiamal14@gmail.com" &&
        incoming().role == "admin";
      allow delete: if isAdmin();
    }

    // Products collection (Public read, Admin managed)
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      allow get: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(orderId) &&
        incoming().id == orderId &&
        incoming().status == 'pending' && (
          (isSignedIn() && incoming().userId == request.auth.uid) ||
          (!isSignedIn() && incoming().userId == 'guest')
        );
      allow update: if isAdmin() || (
        isSignedIn() &&
        existing().userId == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
        incoming().status == 'cancelled'
      );
      allow delete: if isAdmin();
    }

    // Reviews collection (Public read, author/admin managed)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
    }
  }
}
